diff --git a/Loop/Loop/Views/MealToolsView.swift b/Loop/Loop/Views/MealToolsView.swift
new file mode 100644
index 00000000..7a13f551
--- /dev/null
+++ b/Loop/Loop/Views/MealToolsView.swift
@@ -0,0 +1,87 @@
+//
+//  MealToolsView.swift
+//  Loop
+//
+//  CUSTOM (rdeboer180): absorption-pattern selector row and favorites CSV
+//  document glue. Revert: delete this file + its pbxproj entry, the
+//  AbsorptionPatternRow lines in CarbEntryView / AddEditFavoriteFoodView,
+//  and the CSV section in FavoriteFoodsView.
+//
+
+import SwiftUI
+import UniformTypeIdentifiers
+import HealthKit
+import LoopKit
+
+/// CUSTOM (rdeboer180): picks the per-entry absorption pattern. Selecting 🥜
+/// changes which curve Loop uses to model THIS entry's carb absorption (and
+/// therefore its predicted glucose and dosing); it does not change the
+/// selected duration. The text below is derived from the same constants the
+/// curve uses, so it always describes what Loop will actually run.
+struct AbsorptionPatternRow: View {
+    @Binding var identifier: String?
+    let duration: TimeInterval
+    private var selection: Binding<String> {
+        Binding(get: { identifier ?? "" }, set: { identifier = $0.isEmpty ? nil : $0 })
+    }
+    var body: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            Picker("Absorption Pattern", selection: selection) {
+                Text("Standard").tag(MealAbsorptionPattern.standard)
+                Text("🥜 Delayed metabolic response").tag(MealAbsorptionPattern.delayedMetabolicV1)
+                if identifier == nil {
+                    Text("Legacy (from food text)").tag("")
+                }
+                if let identifier, !MealAbsorptionPattern.supportedIdentifiers.contains(identifier) {
+                    Text("Unavailable saved pattern").tag(identifier)
+                }
+            }
+            if identifier == MealAbsorptionPattern.delayedMetabolicV1 {
+                let preview = DelayedMetabolicResponsePreview()
+                let peak = preview.peakAbsorptionWindow(after: duration)
+                let mean = preview.averageLateResponse(after: duration)
+                let range = preview.observedTimingRange(after: duration)
+                Text("Loop will model the fastest absorption \(hours(peak.lowerBound))–\(hours(peak.upperBound)) after eating, centered on \(hours(mean)) (the average late rise seen on \(DelayedMetabolicResponsePreview.sampleCount) evenings; observed spread \(hours(range.lowerBound))–\(hours(range.upperBound))).")
+                    .font(.footnote)
+                Text("Timing scales with the selected duration. This changes this entry's carb prediction and dosing. Glucose rises are not measured carb absorption, and a strong early rise still absorbs the entry early.")
+                    .font(.footnote).foregroundColor(.secondary)
+            } else if identifier == nil {
+                Text("No pattern saved: Loop uses a 🥜12h / 🍲8h text marker if present, otherwise the Standard model.")
+                    .font(.footnote).foregroundColor(.secondary)
+            }
+        }
+    }
+    private func hours(_ time: TimeInterval) -> String {
+        let minutes = Int((time / 60).rounded())
+        return "\(minutes / 60)h \(String(format: "%02d", minutes % 60))m"
+    }
+}
+
+struct FavoritesCSVDocument: FileDocument {
+    static var readableContentTypes: [UTType] { [.commaSeparatedText, .plainText] }
+    var text: String
+    init(text: String) { self.text = text }
+    init(configuration: ReadConfiguration) throws {
+        guard let data = configuration.file.regularFileContents, data.count <= FavoriteFoodCSV.maximumBytes,
+              let text = String(data: data, encoding: .utf8) else {
+            throw FavoriteFoodCSV.InvalidFile(message: "Choose a UTF-8 CSV file smaller than 2 MB.")
+        }
+        self.text = text
+    }
+    func fileWrapper(configuration: WriteConfiguration) throws -> FileWrapper {
+        FileWrapper(regularFileWithContents: Data(text.utf8))
+    }
+}
+
+extension StoredFavoriteFood {
+    var csvRecord: FavoriteCSVRecord {
+        FavoriteCSVRecord(id: id, name: name, grams: carbsQuantity.doubleValue(for: .gram()),
+                          foodType: foodType, absorptionMinutes: absorptionTime / 60,
+                          patternIdentifier: absorptionPatternIdentifier)
+    }
+    init(csvRecord row: FavoriteCSVRecord) {
+        self.init(id: row.id, name: row.name, carbsQuantity: HKQuantity(unit: .gram(), doubleValue: row.grams),
+                  foodType: row.foodType, absorptionTime: row.absorptionMinutes * 60,
+                  absorptionPatternIdentifier: row.patternIdentifier)
+    }
+}
diff --git a/Loop/Loop/Views/PresetRemindersView.swift b/Loop/Loop/Views/PresetRemindersView.swift
new file mode 100644
index 00000000..e71a8fca
--- /dev/null
+++ b/Loop/Loop/Views/PresetRemindersView.swift
@@ -0,0 +1,262 @@
+//
+//  PresetRemindersView.swift
+//  Loop
+//
+//  CUSTOM (rdeboer180): recurring weekday/time reminders to *review* a saved
+//  override preset. Local notifications only; nothing is activated and no
+//  therapy setting changes. Revert: delete this file, its pbxproj entry, the
+//  Settings section, and the two StatusTableViewController lines.
+//
+
+import SwiftUI
+import Combine
+import UserNotifications
+import LoopKit
+
+@MainActor
+final class PresetReminderStore: ObservableObject {
+    static let shared = PresetReminderStore()
+    nonisolated static let notificationCategory = "LoopPresetReminder" // nonisolated: read from the non-main-actor notification delegate
+    private static let prefix = "loop.preset-reminder."
+    private static let storageKey = "com.loopkit.recurringPresetReminders.v1"
+    private struct Archive: Codable { let version: Int; let reminders: [RecurringPresetReminder] }
+
+    @Published private(set) var reminders: [RecurringPresetReminder] = []
+    @Published private(set) var busy = false
+    @Published var errorMessage: String?
+    private(set) var storageIsReadable = true
+    private var presets: () -> [TemporaryScheduleOverridePreset] = { [] }
+    private var lastSignature = ""
+    private var observers = Set<AnyCancellable>()
+
+    private init() {
+        if let data = UserDefaults.standard.data(forKey: Self.storageKey) {
+            do {
+                let archive = try JSONDecoder().decode(Archive.self, from: data)
+                guard archive.version == 1 else { throw Failure("This build cannot read the saved reminder version.") }
+                reminders = archive.reminders
+            } catch {
+                storageIsReadable = false
+                errorMessage = "Saved reminders could not be read. They have not been overwritten. \(error.localizedDescription)"
+            }
+        }
+    }
+
+    func configure(presets: @escaping () -> [TemporaryScheduleOverridePreset]) {
+        self.presets = presets
+        if observers.isEmpty {
+            for name in [Notification.Name.LoopDataUpdated, UIApplication.didBecomeActiveNotification] {
+                NotificationCenter.default.publisher(for: name).receive(on: RunLoop.main).sink { [weak self] _ in
+                    Task { @MainActor in await self?.refreshIfNeeded() }
+                }.store(in: &observers)
+            }
+        }
+        Task { await refreshIfNeeded() }
+    }
+
+    private func signature(_ values: [TemporaryScheduleOverridePreset]) -> String {
+        values.map { $0.id.uuidString + $0.symbol + $0.name }.sorted().joined(separator: "|")
+    }
+
+    private func refreshIfNeeded() async {
+        guard !busy, storageIsReadable else { return }
+        let available = presets(), currentSignature = signature(available)
+        guard currentSignature != lastSignature else { return }
+        let ids = Set(available.map(\.id))
+        let updated = reminders.map { item -> RecurringPresetReminder in
+            var item = item
+            if !ids.contains(item.presetID) { item.enabled = false }
+            return item
+        }
+        do { try await save(updated, requestPermission: false) }
+        catch { errorMessage = error.localizedDescription }
+    }
+
+    func save(_ values: [RecurringPresetReminder], requestPermission: Bool = true) async throws {
+        guard !busy else { throw Failure("A reminder update is already in progress.") }
+        guard storageIsReadable else { throw Failure("Saved reminders must be recovered before they can be changed.") }
+        guard values.count <= 6, Set(values.map(\.id)).count == values.count, values.allSatisfy(\.isValid) else {
+            throw Failure("Use up to six reminders, each with a time and at least one weekday.")
+        }
+        let available = presets(), byID = Dictionary(uniqueKeysWithValues: available.map { ($0.id, $0) })
+        guard values.allSatisfy({ !$0.enabled || byID[$0.presetID] != nil }) else {
+            throw Failure("One of the selected presets no longer exists. Choose another preset.")
+        }
+        let data = try JSONEncoder().encode(Archive(version: 1, reminders: values))
+        busy = true; defer { busy = false }
+        let center = UNUserNotificationCenter.current()
+        if values.contains(where: \.enabled) {
+            var settings = await center.notificationSettings()
+            if settings.authorizationStatus == .notDetermined, requestPermission {
+                _ = try await center.requestAuthorization(options: [.alert, .sound])
+                settings = await center.notificationSettings()
+            }
+            guard settings.authorizationStatus == .authorized || settings.authorizationStatus == .provisional else {
+                throw Failure("Allow Loop notifications in iPhone Settings to receive preset reminders.")
+            }
+        }
+        let pending = await center.pendingNotificationRequests()
+        let old = pending.filter { $0.identifier.hasPrefix(Self.prefix) }
+        var requests: [UNNotificationRequest] = []
+        for item in values where item.enabled {
+            guard let preset = byID[item.presetID] else { continue }
+            for components in item.calendarComponents {
+                let content = UNMutableNotificationContent()
+                content.title = "Review preset: \(preset.symbol) \(preset.name)"
+                content.body = "Open Presets in Loop to review and start it. This reminder has not changed insulin settings."
+                content.sound = .default
+                content.categoryIdentifier = Self.notificationCategory
+                content.userInfo = ["presetID": preset.id.uuidString, "reminderID": item.id.uuidString]
+                let id = Self.prefix + item.id.uuidString + "." + String(components.weekday!)
+                requests.append(UNNotificationRequest(identifier: id, content: content,
+                    trigger: UNCalendarNotificationTrigger(dateMatching: components, repeats: true)))
+            }
+        }
+        // Reserve eight slots for Loop's other notifications. Remove only our requests.
+        guard pending.count - old.count + requests.count <= 56 else {
+            throw Failure("There is not enough notification capacity. Select fewer reminder weekdays.")
+        }
+        center.removePendingNotificationRequests(withIdentifiers: old.map(\.identifier))
+        do {
+            for request in requests { try await center.add(request) }
+        } catch {
+            center.removePendingNotificationRequests(withIdentifiers: requests.map(\.identifier))
+            var restorationFailed = false
+            for request in old {
+                do { try await center.add(request) } catch { restorationFailed = true }
+            }
+            throw Failure(restorationFailed
+                ? "Reminders could not be scheduled or fully restored. Open this screen and save them again."
+                : "Reminders could not be scheduled. Your previous reminders were restored.")
+        }
+        UserDefaults.standard.set(data, forKey: Self.storageKey)
+        reminders = values
+        lastSignature = signature(available)
+    }
+
+    struct Failure: LocalizedError {
+        let message: String
+        init(_ message: String) { self.message = message }
+        var errorDescription: String? { message }
+    }
+}
+
+struct PresetRemindersView: View {
+    let presets: [TemporaryScheduleOverridePreset]
+    @ObservedObject private var store = PresetReminderStore.shared
+    @State private var showEditor = false
+    @State private var draft: RecurringPresetReminder?
+
+    var body: some View {
+        List {
+            Section {
+                Text("Reminders follow local time and repeat on selected weekdays. They ask you to review a saved preset; they never activate it or change a therapy Profile.")
+                    .font(.footnote)
+            }
+            Section("Recurring reminders") {
+                ForEach(store.reminders) { item in
+                    Button {
+                        draft = item; showEditor = true
+                    } label: {
+                        VStack(alignment: .leading, spacing: 4) {
+                            Text(presets.first(where: { $0.id == item.presetID }).map { $0.symbol + " " + $0.name } ?? "Preset removed")
+                            Text(String(format: "%02d:%02d", item.hour, item.minute) + " · " + days(item.weekdays) + (item.enabled ? "" : " · Off"))
+                                .font(.footnote).foregroundColor(.secondary)
+                        }.frame(minHeight: 44)
+                    }
+                    .disabled(store.busy)
+                }
+                .onDelete { indexes in
+                    var values = store.reminders
+                    for i in indexes.sorted(by: >) { values.remove(at: i) }
+                    Task {
+                        do { try await store.save(values) }
+                        catch { store.errorMessage = error.localizedDescription }
+                    }
+                }
+                Button("Add reminder") { draft = nil; showEditor = true }
+                    .disabled(presets.isEmpty || store.reminders.count >= 6 || store.busy || !store.storageIsReadable)
+                if presets.isEmpty { Text("Create a saved preset from the heart control on Loop's main screen first.").font(.footnote) }
+            }
+        }
+        .navigationTitle("Preset Reminders")
+        .sheet(isPresented: $showEditor) { PresetReminderEditor(presets: presets, existing: draft) }
+        .alert("Preset reminders", isPresented: Binding(get: { store.errorMessage != nil }, set: { if !$0 { store.errorMessage = nil } })) {
+            Button("OK", role: .cancel) { store.errorMessage = nil }
+        } message: { Text(store.errorMessage ?? "") }
+    }
+
+    private func days(_ values: Set<Int>) -> String {
+        let names = Calendar.current.shortStandaloneWeekdaySymbols
+        return [2,3,4,5,6,7,1].filter(values.contains).map { names[$0 - 1] }.joined(separator: ", ")
+    }
+}
+
+private struct PresetReminderEditor: View {
+    @Environment(\.dismiss) private var dismiss
+    let presets: [TemporaryScheduleOverridePreset]
+    let existing: RecurringPresetReminder?
+    @ObservedObject private var store = PresetReminderStore.shared
+    @State private var presetID: UUID?
+    @State private var weekdays = Set<Int>()
+    @State private var time = Date()
+    @State private var enabled = true
+    @State private var errorMessage: String?
+
+    var body: some View {
+        NavigationView {
+            Form {
+                Section {
+                    Picker("Saved preset", selection: $presetID) {
+                        Text("Choose a preset").tag(Optional<UUID>.none)
+                        ForEach(presets, id: \.id) { preset in
+                            Text(preset.symbol + " " + preset.name).tag(Optional(preset.id))
+                        }
+                    }
+                    DatePicker("Local time", selection: $time, displayedComponents: .hourAndMinute)
+                    Toggle("Enabled", isOn: $enabled)
+                }
+                Section("Repeat on") {
+                    ForEach([2,3,4,5,6,7,1], id: \.self) { day in
+                        Toggle(Calendar.current.weekdaySymbols[day - 1], isOn: Binding(
+                            get: { weekdays.contains(day) },
+                            set: { if $0 { weekdays.insert(day) } else { weekdays.remove(day) } }))
+                    }
+                }
+                Section { Text("Review the preset in Loop when notified. No preset or Profile will start automatically.").font(.footnote) }
+            }
+            .navigationTitle(existing == nil ? "New reminder" : "Edit reminder")
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) { Button("Cancel") { dismiss() } }
+                ToolbarItem(placement: .confirmationAction) {
+                    Button("Save") { save() }.disabled(presetID == nil || weekdays.isEmpty || store.busy)
+                }
+            }
+            .onAppear {
+                presetID = existing?.presetID ?? presets.first?.id
+                weekdays = existing?.weekdays ?? []
+                enabled = existing?.enabled ?? true
+                if let existing {
+                    time = Calendar.current.date(bySettingHour: existing.hour, minute: existing.minute, second: 0, of: Date()) ?? Date()
+                }
+            }
+            .alert("Could not save reminder", isPresented: Binding(get: { errorMessage != nil }, set: { if !$0 { errorMessage = nil } })) {
+                Button("OK", role: .cancel) { errorMessage = nil }
+            } message: { Text(errorMessage ?? "") }
+        }
+    }
+
+    private func save() {
+        guard let presetID else { return }
+        let c = Calendar.current.dateComponents([.hour, .minute], from: time)
+        let item = RecurringPresetReminder(id: existing?.id ?? UUID(), presetID: presetID, weekdays: weekdays,
+                                          hour: c.hour ?? 0, minute: c.minute ?? 0, enabled: enabled)
+        var values = store.reminders
+        if let index = values.firstIndex(where: { $0.id == item.id }) { values[index] = item }
+        else { values.append(item) }
+        Task {
+            do { try await store.save(values); dismiss() }
+            catch { errorMessage = error.localizedDescription }
+        }
+    }
+}
