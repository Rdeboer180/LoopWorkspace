diff --git a/Loop/LoopTests/LoopTests.swift b/Loop/LoopTests/LoopTests.swift
index b29b1d5c..0d8dfba5 100644
--- a/Loop/LoopTests/LoopTests.swift
+++ b/Loop/LoopTests/LoopTests.swift
@@ -7,11 +7,73 @@
 //
 
 import XCTest
+import HealthKit
+@testable import LoopKit
 
 @testable import Loop
 
 class LoopTests: XCTestCase {}
 
+// CUSTOM (rdeboer180): regression coverage for past-meal favorite drafts. Revert with patch 05.
+final class PastMealFavoriteTests: XCTestCase {
+    private func absorption(observed: Double, active: Bool = false) -> AbsorbedCarbValue {
+        AbsorbedCarbValue(
+            observed: HKQuantity(unit: .gram(), doubleValue: observed),
+            clamped: HKQuantity(unit: .gram(), doubleValue: min(observed, 60)),
+            total: HKQuantity(unit: .gram(), doubleValue: 60),
+            remaining: HKQuantity(unit: .gram(), doubleValue: active ? 30 : 0),
+            observedDate: DateInterval(start: Date(timeIntervalSince1970: 0), duration: 3600),
+            estimatedTimeRemaining: active ? 3600 : 0,
+            timeToAbsorbObservedCarbs: 3600
+        )
+    }
+
+    func testFinishedEstimateRequiresOptInAndPreservesDurationAndMarker() {
+        var saved: NewFavoriteFood?
+        let model = AddEditFavoriteFoodViewModel(carbsQuantity: 60, foodType: "🥜12h", absorptionTime: .hours(12), absorption: absorption(observed: 82.5)) { saved = $0 }
+        model.name = "Peanut dessert"
+        XCTAssertEqual(model.carbsQuantity, 60)
+        XCTAssertEqual(model.observedCarbsQuantity, 82.5)
+        XCTAssertTrue(model.canUseObservedCarbs)
+        model.useObservedCarbs()
+        model.save()
+        XCTAssertEqual(saved?.carbsQuantity.doubleValue(for: .gram()), 82.5)
+        XCTAssertEqual(saved?.absorptionTime, .hours(12))
+        XCTAssertEqual(saved?.foodType, "🥜12h")
+        XCTAssertEqual(model.recordedCarbsQuantity, 60)
+        model.useRecordedCarbs()
+        XCTAssertEqual(model.carbsQuantity, 60)
+    }
+
+    func testActiveAbsorptionIsVisibleButCannotReplaceTheRecordedAmount() {
+        let model = AddEditFavoriteFoodViewModel(carbsQuantity: 60, foodType: "🍲8h", absorptionTime: .hours(8), absorption: absorption(observed: 30, active: true)) { _ in }
+        XCTAssertEqual(model.observedCarbsQuantity, 30)
+        XCTAssertTrue(model.absorptionIsActive)
+        XCTAssertFalse(model.canUseObservedCarbs)
+        model.useObservedCarbs()
+        XCTAssertEqual(model.carbsQuantity, 60)
+    }
+
+    func testMissingAbsorptionStillAllowsSavingRecordedValues() {
+        var saved: NewFavoriteFood?
+        let model = AddEditFavoriteFoodViewModel(carbsQuantity: 60, foodType: "🥜12h", absorptionTime: .hours(12)) { saved = $0 }
+        model.name = "Peanut dessert"
+        XCTAssertNil(model.observedCarbsQuantity)
+        XCTAssertFalse(model.canUseObservedCarbs)
+        model.save()
+        XCTAssertEqual(saved?.carbsQuantity.doubleValue(for: .gram()), 60)
+    }
+
+    func testInvalidOrExcessiveEstimateCannotReplaceRecordedValues() {
+        for grams in [-1.0, 0, Double.nan, Double.infinity, 1000] {
+            let model = AddEditFavoriteFoodViewModel(carbsQuantity: 60, foodType: "🍲8h", absorptionTime: .hours(8), absorption: absorption(observed: grams)) { _ in }
+            XCTAssertFalse(model.canUseObservedCarbs)
+            model.useObservedCarbs()
+            XCTAssertEqual(model.carbsQuantity, 60)
+        }
+    }
+}
+
 extension XCTestCase {
     
